    {
      "parameters": {
        "jsCode": "// Invia posizione per eventi con location\nconst events = $input.all();\nconst output = [];\n\nevents.forEach(event => {\n  if (event.json.location) {\n    output.push({\n      json: {\n        chatId: $node['Telegram Trigger'].json.message.chat.id,\n        location: event.json.location,\n        summary: event.json.summary,\n        start: event.json.start\n      }\n    });\n  }\n});\n\nreturn output;"
      },
