    {
      "parameters": {
        "jsCode": "const eventsToday = $input.first().json;\nconst eventsTomorrow = $input.all()[1]?.json || [];\nconst emailsPayments = $input.all()[2]?.json || [];\n\nlet message = \"🌅 *RIEPILOGO GIORNALIERO*\\n\\n\";\n\n// Eventi di oggi\nmessage += \"📅 *EVENTI DI OGGI:*\\n\";\nif (eventsToday && eventsToday.items && eventsToday.items.length > 0) {\n  eventsToday.items.forEach(event => {\n    const startTime = new Date(event.start.dateTime || event.start.date).toLocaleTimeString('it-IT', {hour: '2-digit', minute: '2-digit'});\n    message += `\\n⏰ ${startTime} - ${event.summary}`;\n    if (event.location) {\n      message += `\\n   📍 ${event.location}`;\n    }\n  });\n} else {\n  message += \"\\nNessun evento oggi\\n\";\n}\n\nmessage += \"\\n\\n📅 *EVENTI DI DOMANI:*\\n\";\nif (eventsTomorrow && eventsTomorrow.items && eventsTomorrow.items.length > 0) {\n  eventsTomorrow.items.forEach(event => {\n    const startTime = new Date(event.start.dateTime || event.start.date).toLocaleTimeString('it-IT', {hour: '2-digit', minute: '2-digit'});\n    message += `\\n⏰ ${startTime} - ${event.summary}`;\n    if (event.location) {\n      message += `\\n   📍 ${event.location}`;\n    }\n  });\n} else {\n  message += \"\\nNessun evento domani\\n\";\n}\n\n// Email pagamenti\nmessage += \"\\n\\n💰 *EMAIL PAGAMENTI:*\\n\";\nif (emailsPayments && emailsPayments.length > 0) {\n  const recentPayments = emailsPayments.slice(0, 10);\n  recentPayments.forEach(email => {\n    const date = new Date(parseInt(email.internalDate)).toLocaleDateString('it-IT');\n    message += `\\n📧 ${date} - ${email.payload.headers.find(h => h.name === 'Subject')?.value || 'Nessun oggetto'}`;\n  });\n} else {\n  message += \"\\nNessuna email sui pagamenti\\n\";\n}\n\nreturn [{json: {message: message}}];"
      },
