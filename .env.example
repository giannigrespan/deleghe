# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth 2.0 Configuration
# (These are configured in n8n credentials, not environment variables)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# n8n Configuration
N8N_LOG_LEVEL=info
GENERIC_TIMEZONE=Europe/Rome
EXECUTIONS_TIMEOUT=300
EXECUTIONS_TIMEOUT_MAX=600

# Notes:
# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit .env file to git
# 3. TELEGRAM_CHAT_ID: Get from https://api.telegram.org/bot<TOKEN>/getUpdates after sending a message to your bot
# 4. OPENAI_API_KEY: Get from https://platform.openai.com/api-keys
# 5. TELEGRAM_BOT_TOKEN: Get from @BotFather on Telegram
